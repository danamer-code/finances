# Copia aquest fitxer a .env.local i omple els valors.
# En local: `supabase status -o env`. A producció: Supabase > Project Settings > API keys / Database.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Només servidor: mai amb prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional (instància d'un sol usuari): correus que poden entrar, separats per comes.
ALLOWED_EMAILS=
# Només local: contrasenya dels usuaris de prova (es creen a Supabase Studio, http://127.0.0.1:54323).
LOCAL_TEST_PASSWORD=prova-local-finances

# Cron diari (Vercel l'envia com a "Authorization: Bearer ...").
CRON_SECRET=
# Preus d'accions i fons: EODHD (https://eodhd.com, el pla gratuït en té prou per a ~18 posicions).
EODHD_API_KEY=
# Opcional, alternativa: preus d'accions i fons des d'un Google Sheet propi (compte de servei de només lectura).
# Cripto (Coinbase) i divises (BCE) no necessiten cap clau.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
PRICES_SHEET_ID=
PRICES_SHEET_RANGE=Preus!A2:C

# Notificacions (Web Push), opcional: si es deixen buides, l'app en genera unes i les desa a la base de dades.
# Per fixar-les: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
