# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: només l'exemple va al repositori
!.env.example

# dades personals reals (exports dels Excels, CSV dels brokers) i informes amb xifres reals
/data/raw/
/docs/private/

# importador de dades personals (Google Sheet, Excel fiscal, brokers) amb la seva configuració: només en local
/privat/

# supabase local
supabase/.branches
supabase/.temp
